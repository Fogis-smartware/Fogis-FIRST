<section class="max-w-container-max mx-auto px-gutter md:px-margin-desktop pb-16"><div class="fade-up"><h2 class="font-headline-lg text-headline-lg text-on-surface mb-8"><span lang="en">Technical Specifications</span><span lang="zh">技术规格</span></h2><div class="bg-white rounded-xl shadow-soft border border-outline-variant overflow-hidden"><table class="w-full"><tbody><tr class="bg-surface-container-low/30 border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">LED Power</span><span lang="zh">LED功率</span></td><td class="py-3 px-5 text-secondary text-sm">70 w ( 7 pcs x 10 w )</td></tr><tr class="border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">LED Chip</span><span lang="zh">LED芯片</span></td><td class="py-3 px-5 text-secondary text-sm">CREE</td></tr><tr class="bg-surface-container-low/30 border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Input Voltage</span><span lang="zh">输入电压</span></td><td class="py-3 px-5 text-secondary text-sm">DC 9 - 60 V</td></tr><tr class="border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Working mode</span><span lang="zh">工作模式</span></td><td class="py-3 px-5 text-secondary text-sm">High</td></tr><tr class="bg-surface-container-low/30 border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Lumens</span><span lang="zh">流明</span></td><td class="py-3 px-5 text-secondary text-sm">5400 lm</td></tr><tr class="border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">IP Rate</span><span lang="zh">防护等级</span></td><td class="py-3 px-5 text-secondary text-sm">IP 67</td></tr><tr class="bg-surface-container-low/30 border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Beam Angle</span><span lang="zh">光束角度</span></td><td class="py-3 px-5 text-secondary text-sm">Flood 60°</td></tr><tr class="border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Color Temperature Range</span><span lang="zh">色温范围</span></td><td class="py-3 px-5 text-secondary text-sm">6000 ~ 6500 K</td></tr><tr class="bg-surface-container-low/30 border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Life Span</span><span lang="zh">寿命</span></td><td class="py-3 px-5 text-secondary text-sm">≤ 30000 h</td></tr><tr class="border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Lamp Cover Material</span><span lang="zh">Lamp Cover Material</span></td><td class="py-3 px-5 text-secondary text-sm">Polycarbonate</td></tr><tr class="bg-surface-container-low/30 border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Lens Material</span><span lang="zh">透镜材质</span></td><td class="py-3 px-5 text-secondary text-sm">PMMA</td></tr><tr class="border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Mounting Bracket Material</span><span lang="zh">Mounting Bracket Material</span></td><td class="py-3 px-5 text-secondary text-sm">Stainless steel</td></tr><tr class="bg-surface-container-low/30 border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Product Dimension</span><span lang="zh">产品尺寸</span></td><td class="py-3 px-5 text-secondary text-sm">15 x 9.2 x 17 cm</td></tr><tr class="border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Product box dimension</span><span lang="zh">包装尺寸</span></td><td class="py-3 px-5 text-secondary text-sm">18 x 12.2 x 30 cm</td></tr><tr class="bg-surface-container-low/30 border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Product weight</span><span lang="zh">产品重量</span></td><td class="py-3 px-5 text-secondary text-sm">1.6 kg</td></tr><tr class="border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Master box dimension</span><span lang="zh">Master box dimension</span></td><td class="py-3 px-5 text-secondary text-sm">63 x 56 x 32 cm</td></tr><tr class="bg-surface-container-low/30 border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Master box Quantity</span><span lang="zh">Master box Quantity</span></td><td class="py-3 px-5 text-secondary text-sm">8 pcs</td></tr><tr class="border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Net weight</span><span lang="zh">净重</span></td><td class="py-3 px-5 text-secondary text-sm">12.8 kg</td></tr><tr class="bg-surface-container-low/30 border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Gross weight</span><span lang="zh">Gross weight</span></td><td class="py-3 px-5 text-secondary text-sm">13.8 kg</td></tr><tr class="border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Warranty</span><span lang="zh">质保</span></td><td class="py-3 px-5 text-secondary text-sm">2 years</td></tr><tr class="bg-surface-container-low/30 border-b border-outline-variant/50"><td class="py-3 px-5 font-semibold text-on-surface w-2/5 text-sm"><span lang="en">Application</span><span lang="zh">应用场景</span></td><td class="py-3 px-5 text-secondary text-sm">Emergency (ex. car break down), inspection of any kind of 4 wheels vehicle and others</td></tr></tbody></table></div></div></section>
